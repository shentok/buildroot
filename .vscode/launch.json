{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch imx8mp-evk",
            "type": "cppdbg",
            "request": "launch",
            "program": "output/build/linux-6.18.2/vmlinux",
            "cwd": "${workspaceFolder}",
            "miDebuggerPath": "aarch64-linux-gnu-gdb",
            "miDebuggerServerAddress": "localhost:1234",
            "setupCommands": [
                {
                    "description": "Add u-boot-spl symbol file",
                    "text": "add-symbol-file ${workspaceFolder}/output/build/uboot-2026.04/spl/u-boot-spl",
                    "ignoreFailures": false
                },
                {
                    "description": "Add u-boot symbol file",
                    "text": "add-symbol-file ${workspaceFolder}/output/build/uboot-2026.04/u-boot 0xffef9000",
                    "ignoreFailures": false
                },
                {
                    "description": "Add A-TF symbol file",
                    "text": "add-symbol-file ${workspaceFolder}/output/build/arm-trusted-firmware-v2.12/build/imx8mp/debug/bl31/bl31.elf",
                    "ignoreFailures": false
                },
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "stopAtEntry": false,
            "stopAtConnect": false,
            "preLaunchTask": "Run imx8mp-evk"
        },
        {
            "name": "Launch ucp1020",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/output/build/uboot-custom/u-boot",
            "cwd": "${workspaceFolder}",
            "miDebuggerPath": "/opt/powerpc-e500v2-toolchain/bin/powerpc-linux-gdb",
            "miDebuggerServerAddress": "localhost:1234",
            "stopAtEntry": false,
            "stopAtConnect": false,
            "preLaunchTask": "Run ucp1020"
        }
    ]
}